{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workflow Manager",
  "version": "0.1.0",
  "identifier": "com.workflowmanager.desktop",
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/fong-hub/workflow-manager/releases/latest/download/latest.json"]
    }
  },
  "build": {
    "frontendDist": "../dist/web",
    "beforeDevCommand": "pnpm build",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{
      "title": "Workflow Manager",
      "width": 1440,
      "height": 960,
      "minWidth": 1024,
      "minHeight": 700,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.svg"],
    "resources": ["../dist/server"]
  }
}
